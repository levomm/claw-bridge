#!/data/data/com.termux/files/usr/bin/sh
set -eu

PROJECT="${CLAW_PROJECT:-$HOME/CLAW-Bridge-v03}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
FILTER="$SCRIPT_DIR/../agent-input-filter.mjs"
PROOT_SANDBOX="${CLAW_CODEX_PROOT_SANDBOX:-danger-full-access}"

run_codex() {
  if command -v proot-distro >/dev/null 2>&1 && proot-distro login ubuntu -- test -x /root/.local/bin/codex >/dev/null 2>&1; then
    exec proot-distro login ubuntu --bind "$PROJECT:/workspace" -- bash -lc '
      cd /workspace
      exec /root/.local/bin/codex "$@"
    ' bash "$@"
  fi

  if [ -x "$HOME/.local/bin/codex-termux-native" ]; then
    exec "$HOME/.local/bin/codex-termux-native" "$@"
  fi

  printf '%s\n' 'CLAW Codex executor unavailable. Install Codex in Ubuntu PRoot or restore codex-termux-native.' >&2
  exit 127
}

if [ "${1:-}" = "exec" ] && [ "${2:-}" = "-" ] && [ -f "$FILTER" ]; then
  if command -v proot-distro >/dev/null 2>&1 && proot-distro login ubuntu -- test -x /root/.local/bin/codex >/dev/null 2>&1; then
    # Codex's Linux sandbox is nested inside Android PRoot here. On this runtime
    # the nested bubblewrap/seccomp path cannot even spawn read-only commands.
    # CLAW already owns the run-level approval gate, so only CLAW's filtered
    # non-interactive exec path uses a configurable full-access Codex sandbox.
    node "$FILTER" | proot-distro login ubuntu --bind "$PROJECT:/workspace" -- env CLAW_CODEX_PROOT_SANDBOX="$PROOT_SANDBOX" bash -lc '
      cd /workspace
      exec /root/.local/bin/codex -s "$CLAW_CODEX_PROOT_SANDBOX" "$@"
    ' bash "$@"
    exit $?
  fi

  if [ -x "$HOME/.local/bin/codex-termux-native" ]; then
    node "$FILTER" | "$HOME/.local/bin/codex-termux-native" "$@"
    exit $?
  fi
fi

run_codex "$@"
